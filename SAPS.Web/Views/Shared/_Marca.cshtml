@* Marca RecyPlast. Aquí (y solo aquí) vive la lógica del logo.
   Usa wwwroot/images/logo-recyplast.svg (o .png) si existe; si no, muestra un placeholder.
   Con el logo oficial solo se agrega la sigla "SAPS", porque el nombre de la empresa ya va dentro del logo.
   No hay lógica de negocio en esta vista. *@
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Entorno
@{
    var archivoLogo = Entorno.WebRootFileProvider.GetFileInfo("images/logo-recyplast.svg").Exists ? "logo-recyplast.svg"
                    : Entorno.WebRootFileProvider.GetFileInfo("images/logo-recyplast.png").Exists ? "logo-recyplast.png"
                    : null;
    var mostrarTexto = ViewData["MarcaSoloLogo"] as bool? != true;
}
@if (archivoLogo != null)
{
    <img src="~/images/@archivoLogo" alt="RecyPlast" class="marca-logo" />
}
else
{
    <span class="marca-placeholder" role="img" aria-label="RecyPlast">
        <svg class="icono icono-lg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 4l-4 7h4M17 20l4-7h-4M4 17l3 3 3-3M20 7l-3-3-3 3"/>
        </svg>
    </span>
}
@if (mostrarTexto)
{
    <span class="marca-texto">
        @if (archivoLogo == null)
        {
            <span class="marca-empresa">RecyPlast</span>
        }
        <span class="marca-sistema">SAPS</span>
    </span>
}
