@model ErrorViewModel
@inject IWebHostEnvironment Entorno
@{
    ViewData["Title"] = "Error";
}

<section class="pagina-estado" aria-labelledby="titulo-estado">
    <span class="pagina-estado-icono error"><partial name="_Iconos" model="@("alerta icono-lg")" /></span>
    <h1 id="titulo-estado">Ocurrió un error</h1>
    <p>No pudimos completar su solicitud. Intente nuevamente en unos minutos.</p>
    <p class="small mb-0">Si el problema continúa, comuníquese con el administrador del sistema.</p>

    @if (Model.ShowRequestId)
    {
        <p class="codigo-referencia">Código de referencia: <code>@Model.RequestId</code></p>
    }

    <div class="pagina-estado-acciones">
        <a class="btn btn-recyplast" asp-area="" asp-controller="Home" asp-action="Index"><partial name="_Iconos" model="@("dashboard icono-sm")" /> Volver al inicio</a>
    </div>

    @* Solo en desarrollo: en producción no se muestra nada técnico. *@
    @if (Entorno.IsDevelopment())
    {
        <p class="aviso-desarrollo">Entorno de desarrollo: esta es la pantalla que verán los usuarios en producción. Los detalles técnicos del error aparecen en la página de excepciones del desarrollador.</p>
    }
</section>
