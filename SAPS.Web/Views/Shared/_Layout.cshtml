@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    var autenticado = SignInManager.IsSignedIn(User);
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var esRrhh = User.IsInRole("RecursosHumanos");
    var esAdmin = User.IsInRole("Administrador");
    var esSoda = User.IsInRole("Soda");
    // Mismas reglas que los [Authorize] de cada controlador.
    var veCatalogo = esAdmin || esRrhh;
    var veRrhh = esAdmin || esRrhh;
    var vePedidos = esAdmin || esSoda;
    var veDashboard = esAdmin || esRrhh || esSoda;   // igual que el [Authorize] de HomeController.Index
    string Activo(bool coincide) => coincide ? "activo" : "";
    string Actual(bool coincide) => coincide ? "page" : "";

    var nombreUsuario = User.Identity?.Name ?? "";
    var iniciales = nombreUsuario.Length >= 2 ? nombreUsuario[..2].ToUpperInvariant() : nombreUsuario.ToUpperInvariant();
    string rolMostrado =
        esAdmin ? "Administrador" : esRrhh ? "Recursos Humanos" : esSoda ? "Soda" : "Sin rol asignado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* [Otras] Título de pestaña en español y con el nombre del sistema, no el del proyecto técnico. *@
    <title>@ViewData["Title"] - SAPS RecyPlast</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SAPS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
    <div class="app-shell @(autenticado ? "" : "sin-sidebar")">
        @if (autenticado)
        {
            <div class="sidebar-fondo" id="sidebar-fondo"></div>
            @* Escritorio: visible. Móvil/tablet: drawer (se abre con el botón del encabezado). *@
            <aside class="sidebar-recyplast" id="sidebar" aria-label="Menú principal">
                <a class="sidebar-marca" asp-area="" asp-controller="Home" asp-action="Index" aria-label="SAPS, ir al inicio">
                    <partial name="_Marca" />
                </a>
                <nav aria-label="Navegación principal">
                    <ul class="sidebar-nav">
                        @if (veDashboard)
                        {
                            <li>
                                <a class="sidebar-link @Activo(controlador == "Home" && area == "")" aria-current="@Actual(controlador == "Home" && area == "")"
                                   asp-area="" asp-controller="Home" asp-action="Index">
                                    <partial name="_Iconos" model="@("dashboard")" /> Inicio
                                </a>
                            </li>
                        }
                        @if (veCatalogo)
                        {
                            <li>
                                <a class="sidebar-link @Activo(controlador == "Administracion")" aria-current="@Actual(controlador == "Administracion")"
                                   asp-area="" asp-controller="Administracion" asp-action="Catalogo">
                                    <partial name="_Iconos" model="@("catalogo")" /> Catálogo
                                </a>
                            </li>
                        }
                        @if (vePedidos)
                        {
                            <li>
                                <a class="sidebar-link @Activo(controlador == "Pedidos")" aria-current="@Actual(controlador == "Pedidos")"
                                   asp-area="" asp-controller="Pedidos" asp-action="Index">
                                    <partial name="_Iconos" model="@("pedidos")" /> Registrar pedido
                                </a>
                            </li>
                        }
                        @if (veRrhh)
                        {
                            <li>
                                <a class="sidebar-link @Activo(controlador == "RecursosHumanos")" aria-current="@Actual(controlador == "RecursosHumanos")"
                                   asp-area="" asp-controller="RecursosHumanos" asp-action="Index">
                                    <partial name="_Iconos" model="@("rrhh")" /> Recursos Humanos
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </aside>
        }

        <div class="app-principal">
            <header class="app-header">
                @if (autenticado)
                {
                    <button type="button" class="btn-menu-movil" id="btn-menu" aria-label="Abrir menú de navegación"
                            title="Menú" aria-controls="sidebar" aria-expanded="false">
                        <partial name="_Iconos" model="@("menu icono-lg")" />
                    </button>
                }
                else
                {
                    <a class="sidebar-marca p-0" asp-area="" asp-controller="Home" asp-action="Index"><partial name="_Marca" /></a>
                }
                <p class="app-header-titulo">@ViewData["Title"]</p>
                @if (autenticado)
                {
                    <div class="app-usuario">
                        <div class="app-usuario-texto text-end">
                            <p class="app-usuario-nombre">@nombreUsuario</p>
                            <p class="app-usuario-rol">@rolMostrado</p>
                        </div>
                        <span class="app-usuario-avatar" title="@nombreUsuario" aria-hidden="true">@iniciales</span>
                        @* [ED03] Cierre de sesión en el Header: mismo formulario de Identity que usaba el menú lateral. *@
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="app-cerrar-sesion">
                            <button type="submit" class="btn btn-recyplast-outline btn-cerrar-sesion" aria-label="Cerrar sesión" title="Cerrar sesión">
                                <partial name="_Iconos" model="@("salir icono-sm")" /><span class="btn-cerrar-sesion-texto">Cerrar sesión</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="app-usuario">
                        <a class="btn btn-recyplast" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
                    </div>
                }
            </header>

            <main role="main" class="app-contenido" id="contenido-principal" tabindex="-1">
                @RenderBody()
            </main>

            @* [H2] Pie de página en español, con el nombre de la empresa y del sistema. *@
            <footer class="app-footer">
                <div class="app-footer-contenido">
                    <div class="app-footer-marca">
                        <partial name="_Marca" view-data='new ViewDataDictionary(ViewData) { { "MarcaSoloLogo", true } }' />
                        <p><strong>SAPS</strong><br />Sistema de Administración para la Soda</p>
                    </div>
                    <address class="app-footer-contacto">
                        <p class="app-footer-titulo">Contacto</p>
                        <a href="tel:+50627680700"><partial name="_Iconos" model="@("telefono icono-sm")" /> (+506) 2768-0700</a>
                        <a href="mailto:info@recyplast.cr"><partial name="_Iconos" model="@("correo icono-sm")" /> info@recyplast.cr</a>
                        <span><partial name="_Iconos" model="@("ubicacion icono-sm")" /> Siquirres, Limón, Costa Rica</span>
                    </address>
                    <span class="app-footer-legal">
                        &copy; @DateTime.Now.Year RecyPlast ·
                        <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    </span>
                </div>
            </footer>
        </div>
    </div>

    @* [H3] Ventana de confirmación reutilizable. La usan los formularios que tengan el atributo data-confirmar. *@
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="modalConfirmarTitulo">Confirmar acción</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalConfirmarMensaje"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="modalConfirmarAceptar">Sí, continuar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
