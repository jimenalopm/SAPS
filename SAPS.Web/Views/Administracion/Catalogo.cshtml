@using System.Globalization
@model SAPS.Web.Models.Catalogo.CatalogoIndexViewModel
@{
    ViewData["Title"] = "Catálogo";
    var cultura = CultureInfo.GetCultureInfo("es-CR");
    string Activa(string nombre) => Model.TabActiva == nombre ? "show active" : "";
    string TarjetaActiva(string nombre) => Model.TabActiva == nombre ? "activa" : "";
    string Colones(int monto) => "₡" + monto.ToString("N0", cultura);
}

<div class="page-header">
    <div>
        <h1 class="h1">Catálogo</h1>
        <p>Gestiona los productos y bebidas disponibles para la soda.</p>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-recyplast alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@* Secciones del catálogo. Cada tarjeta es el mismo enlace de pestaña de antes (?tab=...).
   El número es la cantidad de registros que se muestran con el filtro actual de esa sección. *@
<nav class="catalogo-tarjetas" aria-label="Secciones del catálogo">
    <a class="stat-card @TarjetaActiva("productos")" href="?tab=productos" aria-current="@(Model.TabActiva == "productos" ? "page" : null)">
        <span class="stat-icono"><partial name="_Iconos" model="@("productos icono-lg")" /></span>
        <div>
            <p class="stat-etiqueta">Productos</p>
            <p class="stat-valor">@Model.Productos.Count.ToString("N0", cultura)</p>
            <p class="stat-detalle">mostrados</p>
        </div>
    </a>
    <a class="stat-card @TarjetaActiva("categorias")" href="?tab=categorias" aria-current="@(Model.TabActiva == "categorias" ? "page" : null)">
        <span class="stat-icono azul"><partial name="_Iconos" model="@("categorias icono-lg")" /></span>
        <div>
            <p class="stat-etiqueta">Categorías</p>
            <p class="stat-valor">@Model.Categorias.Count.ToString("N0", cultura)</p>
            <p class="stat-detalle">mostradas</p>
        </div>
    </a>
    <a class="stat-card @TarjetaActiva("tamanos")" href="?tab=tamanos" aria-current="@(Model.TabActiva == "tamanos" ? "page" : null)">
        <span class="stat-icono"><partial name="_Iconos" model="@("tamanos icono-lg")" /></span>
        <div>
            <p class="stat-etiqueta">Tamaños</p>
            <p class="stat-valor">@Model.Tamanos.Count.ToString("N0", cultura)</p>
            <p class="stat-detalle">mostrados</p>
        </div>
    </a>
    <a class="stat-card @TarjetaActiva("bebidas")" href="?tab=bebidas" aria-current="@(Model.TabActiva == "bebidas" ? "page" : null)">
        <span class="stat-icono azul"><partial name="_Iconos" model="@("bebidas icono-lg")" /></span>
        <div>
            <p class="stat-etiqueta">Bebidas</p>
            <p class="stat-valor">@Model.Bebidas.Count.ToString("N0", cultura)</p>
            <p class="stat-detalle">mostradas</p>
        </div>
    </a>
</nav>

<div class="tab-content">

    @* ================= CATEGORÍAS ================= *@
    <div class="tab-pane @Activa("categorias")">
        <div class="catalogo-barra">
            <form method="get" class="catalogo-filtros">
                <input type="hidden" name="tab" value="categorias" />
                <div class="input-buscar">
                    <partial name="_Iconos" model="@("buscar icono-sm")" />
                    <input type="search" name="catQ" value="@Model.CategoriaBuscar" class="form-control" placeholder="Buscar categoría..." aria-label="Buscar categoría" />
                </div>
                <div class="form-check">
                    <input type="checkbox" name="catInc" value="true" class="form-check-input" id="catInc" checked="@Model.CategoriaIncluirInactivos" />
                    <label class="form-check-label" for="catInc">Mostrar inactivas</label>
                </div>
                <button type="submit" class="btn btn-recyplast-outline">Buscar</button>
            </form>
            <a asp-action="CrearCategoria" class="btn btn-recyplast"><partial name="_Iconos" model="@("agregar icono-sm")" /> Nueva categoría</a>
        </div>

        <div class="tabla-contenedor">
        <table class="table table-recyplast tabla-apilable align-middle">
            <thead><tr><th>Nombre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Categorias)
            {
                <tr class="@(c.Activo ? "" : "fila-inactiva")">
                    <td data-label="Nombre" class="celda-principal">@c.NombreCategoria</td>
                    <td data-label="Estado"><span class="badge-recyplast con-punto @(c.Activo ? "" : "gris")">@(c.Activo ? "Activa" : "Inactiva")</span></td>
                    <td class="text-end celda-acciones">
                        <a asp-action="EditarCategoria" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-recyplast-outline"><partial name="_Iconos" model="@("editar icono-sm")" /> Editar</a>
                        <form asp-action="CambiarEstadoCategoria" asp-route-id="@c.IdCategoria" method="post" class="d-inline" data-bloquear-envio
                              data-confirmar="@(c.Activo ? $"¿Desea desactivar la categoría «{c.NombreCategoria}»? Dejará de estar disponible para nuevos pedidos. Podrá activarla de nuevo cuando lo necesite." : null)">
                            <button type="submit" data-texto-procesando="Procesando..." class="btn btn-sm @(c.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(c.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Categorias.Any())
            {
                <tr class="fila-vacia"><td colspan="3" class="estado-vacio">No hay categorías para mostrar.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>

    @* ================= TAMAÑOS ================= *@
    <div class="tab-pane @Activa("tamanos")">
        <div class="catalogo-barra">
            <form method="get" class="catalogo-filtros">
                <input type="hidden" name="tab" value="tamanos" />
                <div class="input-buscar">
                    <partial name="_Iconos" model="@("buscar icono-sm")" />
                    <input type="search" name="tamQ" value="@Model.TamanoBuscar" class="form-control" placeholder="Buscar tamaño..." aria-label="Buscar tamaño" />
                </div>
                <div class="form-check">
                    <input type="checkbox" name="tamInc" value="true" class="form-check-input" id="tamInc" checked="@Model.TamanoIncluirInactivos" />
                    <label class="form-check-label" for="tamInc">Mostrar inactivos</label>
                </div>
                <button type="submit" class="btn btn-recyplast-outline">Buscar</button>
            </form>
            <a asp-action="CrearTamano" class="btn btn-recyplast"><partial name="_Iconos" model="@("agregar icono-sm")" /> Nuevo tamaño</a>
        </div>

        <div class="tabla-contenedor">
        <table class="table table-recyplast tabla-apilable align-middle">
            <thead><tr><th>Nombre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @foreach (var t in Model.Tamanos)
            {
                <tr class="@(t.Activo ? "" : "fila-inactiva")">
                    <td data-label="Nombre" class="celda-principal">@t.NombreTamano</td>
                    <td data-label="Estado"><span class="badge-recyplast con-punto @(t.Activo ? "" : "gris")">@(t.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end celda-acciones">
                        <a asp-action="EditarTamano" asp-route-id="@t.IdTamano" class="btn btn-sm btn-recyplast-outline"><partial name="_Iconos" model="@("editar icono-sm")" /> Editar</a>
                        <form asp-action="CambiarEstadoTamano" asp-route-id="@t.IdTamano" method="post" class="d-inline" data-bloquear-envio
                              data-confirmar="@(t.Activo ? $"¿Desea desactivar el tamaño «{t.NombreTamano}»? Dejará de estar disponible para nuevos pedidos. Podrá activarlo de nuevo cuando lo necesite." : null)">
                            <button type="submit" data-texto-procesando="Procesando..." class="btn btn-sm @(t.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(t.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Tamanos.Any())
            {
                <tr class="fila-vacia"><td colspan="3" class="estado-vacio">No hay tamaños para mostrar.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>

    @* ================= PRODUCTOS ================= *@
    <div class="tab-pane @Activa("productos")">
        <div class="catalogo-barra">
            <form method="get" class="catalogo-filtros">
                <input type="hidden" name="tab" value="productos" />
                <div class="input-buscar">
                    <partial name="_Iconos" model="@("buscar icono-sm")" />
                    <input type="search" name="prodQ" value="@Model.ProductoBuscar" class="form-control" placeholder="Buscar producto..." aria-label="Buscar producto" />
                </div>
                <div class="form-check">
                    <input type="checkbox" name="prodInc" value="true" class="form-check-input" id="prodInc" checked="@Model.ProductoIncluirInactivos" />
                    <label class="form-check-label" for="prodInc">Mostrar inactivos</label>
                </div>
                <button type="submit" class="btn btn-recyplast-outline">Buscar</button>
            </form>
            <a asp-action="CrearProducto" class="btn btn-recyplast"><partial name="_Iconos" model="@("agregar icono-sm")" /> Nuevo producto</a>
        </div>

        <div class="tabla-contenedor">
        <table class="table table-recyplast tabla-apilable align-middle">
            <thead><tr><th>Producto</th><th>Categoría</th><th>Precio(s)</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Productos)
            {
                <tr class="@(p.Activo ? "" : "fila-inactiva")">
                    <td data-label="Producto" class="celda-principal">@p.NombreProducto @(p.EsEspecial ? Html.Raw("<span class=\"badge-recyplast azul ms-1\">Especial</span>") : Html.Raw(""))</td>
                    <td data-label="Categoría">@p.Categoria?.NombreCategoria@(p.Categoria?.Activo == false ? " (inactiva)" : "")</td>
                    <td data-label="Precio(s)">
                        @if (p.RequiereTamano)
                        {
                            <ul class="list-unstyled mb-0 precios-tamano">
                            @foreach (var pr in p.Precios.Where(x => x.Activo && x.IdTamano != null))
                            {
                                <li class="text-nowrap">@pr.Tamano?.NombreTamano@(pr.Tamano?.Activo == false ? " (inactivo)" : ""): <strong>@Colones(pr.MontoPrecio)</strong></li>
                            }
                            </ul>
                        }
                        else
                        {
                            var precio = p.Precios.FirstOrDefault(pr => pr.Activo && pr.IdTamano == null);
                            if (precio != null) { <strong>@Colones(precio.MontoPrecio)</strong> } else { <span class="texto-suave">Sin precio</span> }
                        }
                    </td>
                    <td data-label="Estado"><span class="badge-recyplast con-punto @(p.Activo ? "" : "gris")">@(p.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end celda-acciones">
                        <a asp-action="EditarProducto" asp-route-id="@p.IdProducto" class="btn btn-sm btn-recyplast-outline"><partial name="_Iconos" model="@("editar icono-sm")" /> Editar</a>
                        <form asp-action="CambiarEstadoProducto" asp-route-id="@p.IdProducto" method="post" class="d-inline" data-bloquear-envio
                              data-confirmar="@(p.Activo ? $"¿Desea desactivar el producto «{p.NombreProducto}»? Dejará de estar disponible para nuevos pedidos. Podrá activarlo de nuevo cuando lo necesite." : null)">
                            <button type="submit" data-texto-procesando="Procesando..." class="btn btn-sm @(p.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(p.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Productos.Any())
            {
                <tr class="fila-vacia"><td colspan="5" class="estado-vacio">No hay productos para mostrar.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>

    @* ================= BEBIDAS ================= *@
    <div class="tab-pane @Activa("bebidas")">
        <div class="catalogo-barra">
            <form method="get" class="catalogo-filtros">
                <input type="hidden" name="tab" value="bebidas" />
                <div class="input-buscar">
                    <partial name="_Iconos" model="@("buscar icono-sm")" />
                    <input type="search" name="bebQ" value="@Model.BebidaBuscar" class="form-control" placeholder="Buscar bebida..." aria-label="Buscar bebida" />
                </div>
                <div class="form-check">
                    <input type="checkbox" name="bebInc" value="true" class="form-check-input" id="bebInc" checked="@Model.BebidaIncluirInactivos" />
                    <label class="form-check-label" for="bebInc">Mostrar inactivas</label>
                </div>
                <button type="submit" class="btn btn-recyplast-outline">Buscar</button>
            </form>
            <a asp-action="CrearBebida" class="btn btn-recyplast"><partial name="_Iconos" model="@("agregar icono-sm")" /> Nueva bebida</a>
        </div>

        <div class="tabla-contenedor">
        <table class="table table-recyplast tabla-apilable align-middle">
            <thead><tr><th>Nombre</th><th>Tipo</th><th>Tamaño</th><th>Precio</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @foreach (var b in Model.Bebidas)
            {
                <tr class="@(b.Activo ? "" : "fila-inactiva")">
                    <td data-label="Nombre" class="celda-principal">@b.NombreBebida</td>
                    <td data-label="Tipo"><span class="badge-recyplast azul">@b.TipoBebida</span></td>
                    <td data-label="Tamaño">@(b.Tamano?.NombreTamano ?? "—")@(b.Tamano?.Activo == false ? " (inactivo)" : "")</td>
                    <td data-label="Precio"><strong>@Colones(b.Precio)</strong></td>
                    <td data-label="Estado"><span class="badge-recyplast con-punto @(b.Activo ? "" : "gris")">@(b.Activo ? "Activa" : "Inactiva")</span></td>
                    <td class="text-end celda-acciones">
                        <a asp-action="EditarBebida" asp-route-id="@b.IdBebida" class="btn btn-sm btn-recyplast-outline"><partial name="_Iconos" model="@("editar icono-sm")" /> Editar</a>
                        <form asp-action="CambiarEstadoBebida" asp-route-id="@b.IdBebida" method="post" class="d-inline" data-bloquear-envio
                              data-confirmar="@(b.Activo ? $"¿Desea desactivar la bebida «{b.NombreBebida}»? Dejará de estar disponible para nuevos pedidos. Podrá activarla de nuevo cuando lo necesite." : null)">
                            <button type="submit" data-texto-procesando="Procesando..." class="btn btn-sm @(b.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(b.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Bebidas.Any())
            {
                <tr class="fila-vacia"><td colspan="6" class="estado-vacio">No hay bebidas para mostrar.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>

</div>
