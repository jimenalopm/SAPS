@model SAPS.Web.Models.Catalogo.ProductoFormViewModel
@{ ViewData["Title"] = "Nuevo producto"; }

@* [H1] Ruta de navegación: muestra dónde está la persona y permite volver a cualquier nivel. *@
<nav aria-label="Ruta de navegación" class="breadcrumb-recyplast">
    <a asp-controller="Home" asp-action="Index">Inicio</a>
    <span class="separador"></span><a asp-action="Catalogo">Catálogo</a>
    <span class="separador"></span><a asp-action="Catalogo" asp-route-tab="productos">Productos</a>
    <span class="separador actual" aria-current="page">Nuevo producto</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h1">Nuevo producto</h1>
        <p>Completa la información del producto.</p>
    </div>
</div>

<form asp-action="CrearProducto" method="post" data-bloquear-envio class="form-card">
    <partial name="_ProductoCampos" model="Model" />

    <div class="form-acciones">
        <a asp-action="Catalogo" asp-route-tab="productos" class="btn btn-recyplast-outline">Cancelar</a>
        <button type="submit" class="btn btn-recyplast">Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ProductoScripts" />
}
