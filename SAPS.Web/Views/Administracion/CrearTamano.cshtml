@model SAPS.Web.Models.Catalogo.TamanoFormViewModel
@{ ViewData["Title"] = "Nuevo tamaño"; }

@* [H1] Ruta de navegación: muestra dónde está la persona y permite volver a cualquier nivel. *@
<nav aria-label="Ruta de navegación" class="breadcrumb-recyplast">
    <a asp-controller="Home" asp-action="Index">Inicio</a>
    <span class="separador"></span><a asp-action="Catalogo">Catálogo</a>
    <span class="separador"></span><a asp-action="Catalogo" asp-route-tab="tamanos">Tamaños</a>
    <span class="separador actual" aria-current="page">Nuevo tamaño</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h1">Nuevo tamaño</h1>
        <p>Completa la información del tamaño.</p>
    </div>
</div>

<form asp-action="CrearTamano" method="post" data-bloquear-envio class="form-card form-card-estrecho">
    <div asp-validation-summary="ModelOnly" class="alerta-error-recyplast" role="alert"></div>

    <section aria-labelledby="titulo-info">
        <h2 class="form-card-titulo" id="titulo-info">Información del tamaño</h2>
        <div class="mb-1">
            <label asp-for="NombreTamano" class="form-label">Nombre del tamaño <span class="campo-obligatorio" aria-hidden="true">*</span></label>
            <input asp-for="NombreTamano" class="form-control" autofocus aria-describedby="ayuda-nombre-tamano" />
            <div id="ayuda-nombre-tamano" class="form-text">Por ejemplo: Pequeño, 600ml.</div>
            <span asp-validation-for="NombreTamano" class="text-danger small"></span>
        </div>
        <div class="mb-1 mt-3">
            <label asp-for="Orden" class="form-label">Orden (de menor a mayor) <span class="campo-obligatorio" aria-hidden="true">*</span></label>
            <input asp-for="Orden" class="form-control campo-orden" min="1" max="99" step="1" inputmode="numeric" aria-describedby="ayuda-orden-tamano" />
            <div id="ayuda-orden-tamano" class="form-text">Posición del tamaño: 1 es el más pequeño. Por ejemplo, Pequeño = 1, Mediano = 2, Grande = 3. Sirve para validar que un tamaño mayor no cueste menos que uno menor.</div>
            <span asp-validation-for="Orden" class="text-danger small"></span>
        </div>
    </section>

    <div class="form-acciones">
        <a asp-action="Catalogo" asp-route-tab="tamanos" class="btn btn-recyplast-outline">Cancelar</a>
        <button type="submit" class="btn btn-recyplast">Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
