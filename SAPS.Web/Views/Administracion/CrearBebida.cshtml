@model SAPS.Web.Models.Catalogo.BebidaFormViewModel
@{ ViewData["Title"] = "Nueva bebida"; }

@* [H1] Ruta de navegación: muestra dónde está la persona y permite volver a cualquier nivel. *@
<nav aria-label="Ruta de navegación" class="breadcrumb-recyplast">
    <a asp-controller="Home" asp-action="Index">Inicio</a>
    <span class="separador"></span><a asp-action="Catalogo">Catálogo</a>
    <span class="separador"></span><a asp-action="Catalogo" asp-route-tab="bebidas">Bebidas</a>
    <span class="separador actual" aria-current="page">Nueva bebida</span>
</nav>

<div class="page-header">
    <div>
        <h1 class="h1">Nueva bebida</h1>
        <p>Completa la información de la bebida.</p>
    </div>
</div>

<form asp-action="CrearBebida" method="post" data-bloquear-envio class="form-card">
    <div asp-validation-summary="ModelOnly" class="alerta-error-recyplast" role="alert"></div>

    <section aria-labelledby="titulo-info">
        <h2 class="form-card-titulo" id="titulo-info">Información de la bebida</h2>

        <div class="mb-3">
            <label asp-for="NombreBebida" class="form-label">Nombre de la bebida <span class="campo-obligatorio" aria-hidden="true">*</span></label>
            <input asp-for="NombreBebida" class="form-control" autofocus />
            <span asp-validation-for="NombreBebida" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TipoBebida" class="form-label">Tipo de bebida <span class="campo-obligatorio" aria-hidden="true">*</span></label>
            <select asp-for="TipoBebida" class="form-select">
                <option value="Gaseosa">Gaseosa</option>
                <option value="Embotellada">Embotellada</option>
                <option value="Energizante">Energizante</option>
                <option value="Jugo">Jugo</option>
            </select>
            <span asp-validation-for="TipoBebida" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdTamano" class="form-label">Presentación / tamaño</label>
            <select asp-for="IdTamano" class="form-select">
                <option value="">-- Sin tamaño específico --</option>
                @foreach (var t in Model.TamanosDisponibles)
                {
                    <option value="@t.IdTamano">@t.NombreTamano</option>
                }
            </select>
            <span asp-validation-for="IdTamano" class="text-danger small"></span>
        </div>
    </section>

    <section aria-labelledby="titulo-precio">
        <h2 class="form-card-titulo" id="titulo-precio">Precio</h2>
        <div class="mb-1">
            <label asp-for="Precio" class="form-label">Precio <span class="campo-obligatorio" aria-hidden="true">*</span></label>
            <div class="input-group campo-monto">
                <span class="input-group-text" aria-hidden="true">₡</span>
                <input asp-for="Precio" class="form-control" min="1" max="10000" step="1" inputmode="numeric" />
            </div>
            <span asp-validation-for="Precio" class="text-danger small"></span>
        </div>
    </section>

    <div class="form-acciones">
        <a asp-action="Catalogo" asp-route-tab="bebidas" class="btn btn-recyplast-outline">Cancelar</a>
        <button type="submit" class="btn btn-recyplast">Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
