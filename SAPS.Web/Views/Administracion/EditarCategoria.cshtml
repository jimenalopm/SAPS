@model SAPS.Web.Models.Catalogo.CategoriaFormViewModel
@{ ViewData["Title"] = "Editar categoría"; }

<h1>Editar categoría</h1>
<div class="row">
    <div class="col-md-5">
        <form asp-action="EditarCategoria" method="post">
            <input type="hidden" asp-for="IdCategoria" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="NombreCategoria" class="form-control" placeholder="Nombre de la categoría" autofocus />
                <label asp-for="NombreCategoria">Nombre de la categoría</label>
                <span asp-validation-for="NombreCategoria" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-recyplast">Guardar cambios</button>
            <a asp-action="Catalogo" asp-route-tab="categorias" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
