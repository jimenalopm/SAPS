@model SAPS.Web.Models.Catalogo.TamanoFormViewModel
@{ ViewData["Title"] = "Editar tamaño"; }

@* [H1] Ruta de navegación: muestra dónde está la persona y permite volver a cualquier nivel. *@
<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Catalogo">Catálogo</a></li>
        <li class="breadcrumb-item"><a asp-action="Catalogo" asp-route-tab="tamanos">Tamaños</a></li>
        <li class="breadcrumb-item active" aria-current="page">Editar tamaño</li>
    </ol>
</nav>

<h1>Editar tamaño</h1>
<div class="row">
    <div class="col-md-5">
        <form asp-action="EditarTamano" method="post" data-bloquear-envio>
            <input type="hidden" asp-for="IdTamano" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="NombreTamano" class="form-control" placeholder="Nombre del tamaño" autofocus />
                <label asp-for="NombreTamano">Nombre del tamaño</label>
                <span asp-validation-for="NombreTamano" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-recyplast">Guardar cambios</button>
            <a asp-action="Catalogo" asp-route-tab="tamanos" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
