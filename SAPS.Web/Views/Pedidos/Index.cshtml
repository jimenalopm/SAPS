@{
    ViewData["Title"] = "Registrar pedido";
}
<h1>Registrar pedido</h1>
<p>Atiende: <strong>@User.Identity?.Name</strong>. Los artículos se cargarán al colaborador que seleccione.</p>
@if (ViewData["EsPrueba"] is true)
{
    <div class="alert alert-warning">Entorno de prueba: nombres y fotos ficticios. Códigos: <strong>DEMO001</strong> y <strong>DEMO002</strong> (activos); <strong>DEMO003</strong> (inactivo).</div>
}
<div id="mensaje-pedido" class="alert d-none" role="alert" tabindex="-1"></div>
<div id="pedido-app" data-colaborador-url="@Url.Action("Colaborador")" data-catalogo-url="@Url.Action("Catalogo")" data-registro-url="@Url.Action("Registrar")">
    @Html.AntiForgeryToken()
    <fieldset id="controles-pedido">
        <section class="card mb-3" aria-labelledby="titulo-colaborador">
            <div class="card-body">
                <h2 class="h4" id="titulo-colaborador">1. Identificar al colaborador</h2>
                <form id="buscar-colaborador" class="row g-2 align-items-end">
                    <div class="col-sm-6"><label class="form-label" for="codigo-colaborador">Código de empleado</label><input class="form-control" id="codigo-colaborador" maxlength="50" autocomplete="off" required /></div>
                    <div class="col-sm-auto"><button class="btn btn-recyplast" type="submit">Buscar colaborador</button></div>
                </form>
                <div id="datos-colaborador" class="mt-3 d-none" aria-live="polite">
                    <div id="foto-colaborador" role="img" class="foto-colaborador"></div>
                    <p class="mb-1"><strong id="nombre-colaborador"></strong></p><p id="codigo-encontrado"></p>
                    <p class="text-muted mb-0">Verifique que la foto corresponda a la persona que solicita el pedido.</p>
                </div>
            </div>
        </section>
        <div class="row g-3">
            <section class="col-lg-5" aria-labelledby="titulo-articulos">
                <div class="card h-100"><div class="card-body">
                    <h2 class="h4" id="titulo-articulos">2. Agregar artículos</h2>
                    <label class="form-label" for="tipo-comida">Tipo de comida</label>
                    <select id="tipo-comida" class="form-select mb-3"><option value="">Seleccione…</option><option>Desayuno</option><option>Almuerzo</option><option>Merienda</option></select>
                    <form id="agregar-articulo">
                        <label class="form-label" for="articulo">Producto, adicional o bebida</label>
                        <select id="articulo" class="form-select mb-2" required><option value="">Cargando catálogo…</option></select>
                        <p id="estado-catalogo" class="text-muted" aria-live="polite"></p>
                        <label class="form-label" for="cantidad">Cantidad</label>
                        <input id="cantidad" class="form-control mb-2" type="number" min="1" max="2147483647" step="1" value="1" required />
                        <button type="submit" class="btn btn-recyplast" id="agregar" disabled>Agregar al pedido</button>
                        <button type="button" class="btn btn-outline-secondary mt-1" id="actualizar-catalogo">Actualizar catálogo</button>
                    </form>
                    <p class="text-muted mt-3">Seleccione también los acompañamientos y adicionales del catálogo. Los precios los define la administración.</p>
                </div></div>
            </section>
            <section class="col-lg-7" aria-labelledby="titulo-detalle">
                <div class="card"><div class="card-body">
                    <h2 class="h4" id="titulo-detalle">3. Detalle del pedido</h2>
                    <p id="pedido-vacio">Todavía no hay artículos en el pedido.</p>
                    <div class="table-responsive"><table class="table" id="tabla-detalle" hidden>
                        <thead><tr><th>Artículo</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th><th><span class="visually-hidden">Acciones</span></th></tr></thead>
                        <tbody id="lineas-pedido"></tbody>
                    </table></div>
                    <p class="fs-4 text-end" aria-live="polite">Total: <strong id="total-pedido">₡0</strong></p>
                    <p class="text-muted text-end">Sin impuestos. Cobro por rebajo de planilla.</p>
                    <label for="observaciones" class="form-label">Observaciones (opcional)</label>
                    <textarea id="observaciones" class="form-control mb-3" maxlength="500" rows="2" placeholder="Ejemplo: sin cebolla"></textarea>
                    <button id="registrar-pedido" class="btn btn-recyplast" type="button" disabled>Registrar pedido</button>
                    <button id="descartar-pedido" class="btn btn-outline-secondary" type="button">Descartar pedido</button>
                    <p class="text-muted mt-2 mb-0">El pedido se guarda solamente al pulsar “Registrar pedido”. Si cierra sesión o recarga antes de registrarlo, se descarta.</p>
                </div></div>
            </section>
        </div>
    </fieldset>
</div>
@section Scripts {
    <script src="~/js/pedidos.js" asp-append-version="true"></script>
}
