@page
@model CambiarContrasenaModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    // Cambio obligatorio (primer ingreso o contraseña vencida): se muestra con el diseño del login,
    // sin menú ni barra lateral, y al terminar se vuelve al login a entrar con la contraseña nueva.
    if (Model.Obligatorio)
    {
        Layout = "/Views/Shared/_LayoutAuth.cshtml";
    }
}

@if (Model.Obligatorio)
{
    <div class="auth-shell">
        <partial name="_AuthPanel" />

        <main class="auth-formulario" id="contenido-principal" tabindex="-1">
            <div class="auth-formulario-caja centrado">
                <div class="auth-marca-movil"><partial name="_Marca" /></div>
                <h1 class="auth-titulo">@(Model.Motivo == "primerIngreso" ? "Cree su contraseña" : "Su contraseña venció")</h1>
                <p class="auth-subtitulo">
                    @(Model.Motivo == "primerIngreso"
                        ? "Es su primer ingreso. Escriba la contraseña temporal que le dio el administrador y elija una contraseña nueva. Luego inicie sesión con ella."
                        : "Debe establecer una contraseña nueva antes de continuar. Luego inicie sesión con ella.")
                </p>

                <partial name="_FormularioCambiarContrasena" model="Model" />

                <p class="auth-pie">&copy; @DateTime.Now.Year RecyPlast</p>
            </div>
        </main>
    </div>
}
else
{
    <nav aria-label="Ruta de navegación" class="breadcrumb-recyplast">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <span class="separador actual" aria-current="page">Cambiar contraseña</span>
    </nav>

    <div class="page-header">
        <div>
            <h1 class="h1">Cambiar contraseña</h1>
            <p>Puede cambiar su contraseña cuando lo desee. No es obligatorio.</p>
        </div>
    </div>

    @if (Model.Mensaje != null)
    {
        <div class="alert alert-recyplast alert-dismissible fade show" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <partial name="_FormularioCambiarContrasena" model="Model" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
