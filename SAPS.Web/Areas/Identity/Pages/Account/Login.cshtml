@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="auth-shell">
    <partial name="_AuthPanel" />

    <main class="auth-formulario" id="contenido-principal" tabindex="-1">
        <div class="auth-formulario-caja">
            <div class="auth-marca-movil"><partial name="_Marca" /></div>
            <h1 class="auth-titulo">Bienvenido a SAPS</h1>
            <p class="auth-subtitulo">Inicia sesión para continuar</p>

            <form id="account" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="auth-alerta" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.CodigoEmpleado" class="form-label">Código de empleado</label>
                    <input asp-for="Input.CodigoEmpleado" class="form-control" autocomplete="username" autofocus
                           aria-required="true" placeholder="Ingresa tu código"
                           data-val-required="Ingresa tu código de empleado." />
                    <span asp-validation-for="Input.CodigoEmpleado" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <div class="input-grupo">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                               aria-required="true" placeholder="Ingresa tu contraseña"
                               data-val-required="Ingresa tu contraseña." />
                        <button type="button" class="input-grupo-boton" id="ver-contrasena"
                                aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
                            <span data-icono="ojo"><partial name="_Iconos" model="@("ojo")" /></span>
                            <span data-icono="ojo-cerrado" hidden><partial name="_Iconos" model="@("ojo-cerrado")" /></span>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Recordar mi sesión en este equipo</label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-recyplast btn-lg w-100">Iniciar sesión</button>
            </form>

            <p class="auth-pie">&copy; @DateTime.Now.Year RecyPlast</p>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const boton = document.getElementById('ver-contrasena');
            const campo = document.getElementById('Input_Password');
            if (!boton || !campo) return;
            boton.addEventListener('click', function () {
                const visible = campo.type === 'password';
                campo.type = visible ? 'text' : 'password';
                boton.setAttribute('aria-pressed', String(visible));
                boton.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
                boton.title = boton.getAttribute('aria-label');
                boton.querySelector('[data-icono="ojo"]').hidden = visible;
                boton.querySelector('[data-icono="ojo-cerrado"]').hidden = !visible;
            });
        })();
    </script>
}
