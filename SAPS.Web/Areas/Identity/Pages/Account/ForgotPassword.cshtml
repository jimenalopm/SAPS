@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="auth-shell">
    <partial name="_AuthPanel" />

    <main class="auth-formulario" id="contenido-principal" tabindex="-1">
        <div class="auth-formulario-caja">
            <div class="auth-marca-movil"><partial name="_Marca" /></div>
            <span class="pagina-estado-icono azul"><partial name="_Iconos" model="@("ayuda icono-lg")" /></span>
            <h1 class="auth-titulo">Recuperación de contraseña no disponible</h1>
            <p class="auth-subtitulo">Por ahora SAPS no permite restablecer la contraseña por correo electrónico.</p>

            <p>Si olvidó su contraseña, comuníquese con el administrador del sistema para que la restablezca.</p>

            <a class="btn btn-recyplast btn-lg w-100 mt-3" asp-page="./Login">Volver al inicio de sesión</a>
        </div>
    </main>
</div>
